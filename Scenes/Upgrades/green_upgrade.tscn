[gd_scene format=3 uid="uid://cvxa2l51320du"]

[sub_resource type="GDScript" id="GDScript_x7v1i"]
script/source = "extends Upgrade

@export var modulate_override : Color = Color(0.0, 5.0, 0.0)
@export var turn_speed_multiplier : float = 0.1
@export var speed_multipler : float = 2
@export var angle_dif_multiplier : float = 0.25

func init(entity : Entity) -> void:
	entity.sprite_handler.self_modulate = modulate_override 
	entity.speed *= speed_multipler
	entity.turn_speed *= turn_speed_multiplier
	entity.angle_dif_before_moving *= angle_dif_multiplier
	
func exit(entity : Entity) -> void:
	entity.sprite_handler.self_modulate = Color.WHITE
	entity.speed /= speed_multipler
	entity.turn_speed /= turn_speed_multiplier
	entity.angle_dif_before_moving /= angle_dif_multiplier
"

[node name="Green_Upgrade" type="Node2D" unique_id=766926428]
script = SubResource("GDScript_x7v1i")
modulate_override = Color(0.43137255, 1, 1, 1)

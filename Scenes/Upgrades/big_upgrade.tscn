[gd_scene format=3 uid="uid://8oasxeglamcb"]

[sub_resource type="GDScript" id="GDScript_hmcd0"]
script/source = "extends Upgrade

@export var size_multiplier : float = 1.75
@export var speed_multiplier : float = 2.0
@export var health_multiplier : float = 1.5
@export var mass_multiplier : float = 3.0

func init(entity : Entity) -> void:
	entity.get_node(\"Collider\").scale *= size_multiplier
	entity.radius *= size_multiplier
	entity.sprite_handler.scale *= size_multiplier
	entity.speed *= speed_multiplier
	entity.max_health *= health_multiplier
	entity.health = entity.max_health
	entity.mass *= mass_multiplier

func exit(entity : Entity) -> void:
	entity.get_node(\"Collider\").scale /= size_multiplier
	entity.radius /= size_multiplier
	entity.sprite_handler.scale /= size_multiplier
	entity.speed /= speed_multiplier
	entity.max_health /= health_multiplier
	entity.health = entity.max_health
	entity.mass /= mass_multiplier
"

[node name="Big_Upgrade" type="Node2D" unique_id=2141293767]
script = SubResource("GDScript_hmcd0")

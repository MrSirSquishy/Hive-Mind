[sub_resource type="GDScript" id="GDScript_lj6bu"]
script/source = "extends Upgrade

@export var sprite : Sprite2D

func init(entity : Entity) -> void:
	sprite.reparent(entity.sprite_handler, false)
	entity.speed *= 0.75
	entity.attack_damage *= 2

func exit(entity : Entity) -> void:
	sprite.reparent(self)
	entity.speed /= 0.75
	entity.attack_damage /= 2
"

